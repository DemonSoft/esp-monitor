#!/bin/bash

# Функция очистки фоновых процессов при выходе (Ctrl+C)
cleanup() {
    echo -e "\n🛑 Останавливаем все фоновые процессы..."
    kill $TUNNEL_PID $FORWARD_MOSQUITTO_PID $FORWARD_KAFKA_PID $FORWARD_GRAFANA_PID $FORWARD_SERVER_PID 2>/dev/null
    echo "👋 Окружение успешно остановлено."
    exit 0
}
trap cleanup SIGINT SIGTERM
# Переходим в директорию, где физически лежит сам этот скрипт
cd "$(dirname "$0")" || exit 1

# 0. Запуск Docker Desktop, если он еще не запущен
if ! docker info > /dev/null 2>&1; then
    echo "🐳 Docker Desktop не запущен. Запускаем..."
    open -a Docker

    # Ожидание полной инициализации Docker
    echo "⏳ Ожидаем запуск демона Docker..."
    until docker info > /dev/null 2>&1; do
        sleep 2
    done
    echo "✅ Docker Desktop успешно запущен!"
else
    echo "✅ Docker Desktop уже работает."
fi

echo "🚀 Запуск IoT-окружения (Конфигурация HUGE)..."

# 1. Стартуем Minikube
echo "📦 Запуск кластера Minikube..."
minikube start --driver=docker

# 2. Очистка портов от старых процессов в macOS
echo "🔍 Проверка локальных портов на наличие устаревших процессов..."
for PORT in 1883 9092 9000 3000 8080; do
    PID=$(lsof -t -i:$PORT)
    if [ ! -z "$PID" ]; then
        echo "⚠️ Порт $PORT занят процессом (PID: $PID). Принудительно завершаем..."
        kill -9 $PID
        sleep 1
    fi
done
echo "✅ Все необходимые локальные порты свободны."

# 3. Работа с переменными окружения и Секретами Kubernetes
if [ -f ".env" ]; then
    echo "🔑 Загрузка переменных окружения из .env..."
    export $(grep -v '^#' .env | xargs)
else
    echo "⚠️ Файл .env не найден! Копируем из .env.example..."
    cp .env.example .env
    export $(grep -v '^#' .env | xargs)
fi

if [ -z "$OPENROUTER_API_KEY" ]; then
    echo "❌ Ошибка: Переменная OPENROUTER_API_KEY не задана в файле .env!"
    exit 1
fi

echo "🔐 Пересоздаем Kubernetes Secret для OpenRouter..."
kubectl delete secret openrouter-secret --ignore-not-found
kubectl create secret generic openrouter-secret --from-literal=OPENROUTER_API_KEY="$OPENROUTER_API_KEY"

# 4. Применяем манифесты Kubernetes в строгом порядке
echo "🏗️ Развертывание инфраструктуры и приложений в кластер..."

kubectl delete job kafka-init-topics-job --ignore-not-found=true
kubectl apply -f infra.yaml

echo "⏳ Ожидание загрузки образов инфраструктуры и запуска подов..."
echo "(Это может занять 1-3 минуты при первом запуске)..."

# Ждем, пока базы данных и брокеры выйдут в состояние готовности
kubectl wait --for=condition=ready pod -l app=kafka --timeout=300s
kubectl wait --for=condition=ready pod -l app=mosquitto --timeout=300s

echo "✅ Ядро инфраструктуры готово!"

# Выводим честный статус
echo "===================================================="
echo "Развертывание успешно инициализировано через infra.yaml!"
echo "===================================================="
echo "--> Текущие задачи (Инициализация тем):"
kubectl get jobs

echo ""
echo "--> Статус развертывания подов:"
kubectl get pods
echo "===================================================="
echo ""

echo "--> Ожидание стабилизации CoreDNS..."
kubectl rollout status deployment/coredns -n kube-system --timeout=90s

# 5. Запуск туннеля Minikube в фоновом режиме
echo "🚇 Запуск Minikube tunnel (может потребоваться пароль sudo)..."
sudo -v 
sudo minikube tunnel > /dev/null 2>&1 &
TUNNEL_PID=$!
echo "✅ Туннель запущен в фоне (PID: $TUNNEL_PID)"

# 6. Проброс портов в фоновом режиме для локальной разработки
echo "🔌 Настройка проброса портов (port-forward)..."
kubectl port-forward service/mosquitto-service 1883:1883 --address 0.0.0.0 > /dev/null 2>&1 &
FORWARD_MOSQUITTO_PID=$!

kubectl port-forward service/kafka-service 9092:9092 --address 0.0.0.0 > /dev/null 2>&1 &
FORWARD_KAFKA_PID=$!

kubectl port-forward service/grafana-service 3000:3000 --address 0.0.0.0 > /dev/null 2>&1 &
FORWARD_GRAFANA_PID=$!

kubectl port-forward service/esp-server-service 8080:80 --address 0.0.0.0 > /dev/null 2>&1 &
FORWARD_SERVER_PID=$!
echo "✅ Все порты успешно проброшены."

# 7. Открываем веб-интерфейсы
echo "⏳ Ожидание доступности веб-интерфейсов (5 секунд)..."
sleep 5

echo "📊 Открываем Grafana..."
open http://localhost:3000

echo "🔍 Запуск и открытие веб-интерфейса Kafdrop..."
minikube service kafdrop-service &

echo "☸️ Открытие панели управления Kubernetes Dashboard..."
minikube dashboard &

echo "🎉 Все системы успешно запущены и готовы к работе!"
echo "--------------------------------------------------"
echo "Бэкенд (esp-server) доступен по адресу: http://127.0.0.1:8080"
echo "MQTT-брокер ожидает подключения контроллеров на порту: 1883"
echo "Брокер Kafka доступен локально на порту: 9092"
echo "Панель Grafana открыта по адресу: http://localhost:3000"
echo "--------------------------------------------------"
echo "💡 НАЖМИТЕ CTRL+C, ЧТОБЫ ОСТАНОВИТЬ ВСЕ СЕРВИСЫ И ЗАКРЫТЬ ПРОБРОСЫ ПОРТОВ"
echo "--------------------------------------------------"

# ---- Автоматическое открытие нового окна с отслеживанием подов ----
CURRENT_DIR=$(pwd)
echo "📂 Открытие активной рабочей области в новом окне Terminal..."

osascript -e "tell application \"Terminal\"
    do script \"cd '$CURRENT_DIR' && echo '=== Kubernetes Status ===' && kubectl get svc && kubectl get pods\"
    activate
end tell"

# Оставляем скрипт активным для работы перехватчика trap
wait