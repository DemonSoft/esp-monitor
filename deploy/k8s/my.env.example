# =============================================================================
# GLOBAL APPLICATION SETTINGS
# =============================================================================
# Current deployment environment (used inside application code logic)
ENVIRONMENT=production

# =============================================================================
# ESP SERVER CONFIGURATION
# =============================================================================
# Secret authorization token used to validate incoming ESP controller requests
XTOKEN=<UUID or security string. For example: 00000000-0000-0000-0000-000000000000>

# =============================================================================
# MQTT CONFIGURATION
# =============================================================================
# Root topic prefix identifier (e.g., unique company UUID or project namespace)
MQTT_ROOT=root

# Unique client identifier used for establishing a distinct broker connection
MQTT_CLIENT_ID=mqtt_client

# =============================================================================
# HWORKER CONFIGURATION (Action Dispatcher)
# =============================================================================
# Destination endpoint for sending POST automation payloads (e.g., n8n webhook URL)
# Note: 'host.minikube.internal' lets the K8s cluster access your host machine's localhost
WEBHOOK_URL=http://host.minikube.internal:8080/webhook

# =============================================================================
# THIRD-PARTY API KEYS & SECRETS (AI Worker)
# =============================================================================
# Secret API Token for OpenRouter integration (Required for ai-worker execution)
OPENROUTER_API_KEY=<your_openrouter_api_key_here>