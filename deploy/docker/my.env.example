# ==============================================================================
# GLOBAL APPLICATION SETTINGS
# ==============================================================================
# Global docker image tag for custom services (esp-server, ai-worker, hworker)
APP_VERSION=latest
ENVIRONMENT=local

# ==============================================================================
# ESP SERVER CONFIGURATION
# ==============================================================================
# Authorization token for the server security validation
XTOKEN=00000000-0000-0000-0000-000000000000

# The port on which the server will accept HTTP/REST requests inside/outside docker
REST_PORT=80

# ==============================================================================
# MQTT CONFIGURATION
# ==============================================================================
# For TINY:   set MQTT_PROTOCOL=tcp:// and MQTT_HOST=test.mosquitto.org
# For SMALL+: set MQTT_PROTOCOL=mqtt:// and MQTT_HOST=mosquitto (inside docker network)
MQTT_PROTOCOL=mqtt://
MQTT_HOST=mosquitto
MQTT_PORT=1883

MQTT_USERNAME=
MQTT_PASSWORD=

# Root topic identifier (e.g. company name or unique UUID)
MQTT_ROOT=019ec116-ca6b-711e-a7c5-46d07922cd62
# Unique client identifier for the broker connection
MQTT_CLIENT_ID=esp-monitor-server-client

MQTT_KEEP_ALIVE=60
MQTT_PING_TIMEOUT=10

# ==============================================================================
# KAFKA KRAFT MODE CONFIGURATION (Used from MEDIUM and above)
# ==============================================================================
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_LOG_DIRS=/tmp/kraft-combined-logs

# Pre-generated unique cluster ID for KRaft mode execution
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# List of spaces separated topics to be auto-created by init containers / jobs
KAFKA_TOPICS_TO_CREATE=root logs actions pins anomalies

# ==============================================================================
# APP / WORKER CONNECTIVITY CONFIGURATION (Used from MEDIUM and above)
# ==============================================================================
# Internal routing host. Change to 'kafka-service' for Kubernetes (HUGE configuration)
KAFKA_RUN=true
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_DEFAULT_TOPIC=root

# ==============================================================================
# HWORKER CONFIGURATION (Used from MEDIUM and above)
# ==============================================================================
# Destination endpoint for notification webhooks (e.g. n8n workflow URL)
WEBHOOK_URL=http://n8n:5670/webhook/your-dispatched-id

# ==============================================================================
# THIRD-PARTY API KEYS & SECRETS (Used from MEDIUM and above)
# ==============================================================================
# Secret token for AI operations. Keep it blank in .example file
OPENROUTER_API_KEY=

# ==============================================================================
# INFRASTRUCTURE VERSIONS (For Docker Compose management)
# ==============================================================================
MOSQUITTO_VERSION=latest
KAFKA_VERSION=3.7.0
VECTOR_VERSION=0.44.0-debian
VICTORIAMETRICS_VERSION=v1.101.0
GRAFANA_VERSION=10.4.1

# ==============================================================================
# KAFDROP CONFIGURATION
# ==============================================================================
# Image version for Kafdrop web UI
KAFDROP_VERSION=4.0.2

# The port on which Kafdrop will be accessible on your host machine (http://localhost:9000)
KAFDROP_PORT=9000